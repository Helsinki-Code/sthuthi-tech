# Resend (https://resend.com) — used by api/contact.ts to send contact-form emails.
# Server-side only: never prefix this with VITE_, or it would be bundled into client code.
RESEND_API_KEY=

# Where contact-form submissions get sent.
CONTACT_TO_EMAIL=admin@sthuthi-tech.com

# The "from" address Resend sends as — must be on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Sthuthi Web <onboarding@resend.dev>

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Public/client-side — must be prefixed with VITE_.
# This is a DIFFERENT property from the main sthuthi-tech.com site — leave unset until a
# real web.sthuthi-tech.com GA4 property/stream exists. Unlike the main site, this does
# NOT fall back to a hardcoded ID; analytics simply no-op until this is set.
VITE_GA_MEASUREMENT_ID=
