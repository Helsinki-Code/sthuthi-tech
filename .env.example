# Resend (https://resend.com) — used by api/contact.ts to send contact-form emails.
# Server-side only: never prefix this with VITE_, or it would be bundled into client code.
RESEND_API_KEY=

# Where contact-form submissions get sent, by reason.
CONTACT_TO_EMAIL=programs@sthuthitech.com
VERIFY_TO_EMAIL=verify@sthuthitech.com

# The "from" address Resend sends as — must be on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Sthuthi Technologies <onboarding@resend.dev>

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Public/client-side — must be prefixed with VITE_.
# Optional: src/lib/analytics.ts already falls back to the live property
# (G-FYNBKLSZ47) when this is unset, so it's only needed to point at a
# different GA4 property (e.g. a staging one).
VITE_GA_MEASUREMENT_ID=
